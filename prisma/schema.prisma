generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  SUPERADMIN
  USER
}
enum TenantRole {
  OWNER
  ADMIN
  MEMBER
}
enum EventRole {
  MANAGER
  REGISTRATION_STAFF
  CHECKIN_STAFF
  VIEWER
}
enum EventType {
  FUN_RUN
  SEMINAR
  WEBINAR
}
enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}
enum PaymentProvider {
  MIDTRANS_TENANT
  MIDTRANS_GLOBAL
}
enum OrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
  FAILED
}
enum RegistrationStatus {
  REGISTERED
  PAID
  VERIFICATION_PENDING
  VERIFIED_ON_SITE
  RACE_PACK_COLLECTED
  CHECKED_IN
  ISSUE
  REJECTED
}
enum FieldType {
  TEXT
  TEXTAREA
  EMAIL
  PHONE
  NUMBER
  DATE
  SELECT
  RADIO
  CHECKBOX
  FILE
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  platformRole PlatformRole @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tenantMembers TenantMember[]
  eventMembers  EventMember[]
  orders        Order[]
  auditLogs     AuditLog[]
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members       TenantMember[]
  events        Event[]
  paymentConfig PaymentConfig?
  vouchers      Voucher[]
}

model TenantMember {
  id       String     @id @default(cuid())
  tenantId String
  userId   String
  role     TenantRole
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([tenantId, userId])
  @@index([userId])
}

model Event {
  id                         String          @id @default(cuid())
  tenantId                   String
  name                       String
  slug                       String          @unique
  type                       EventType
  status                     EventStatus     @default(DRAFT)
  description                Text?
  coverUrl                   String?
  startsAt                   DateTime
  endsAt                     DateTime?
  venue                      String?
  timezone                   String          @default("Asia/Makassar")
  capacity                   Int?
  paymentProvider            PaymentProvider @default(MIDTRANS_GLOBAL)
  requiresOnSiteVerification Boolean         @default(false)
  requiresRacePack           Boolean         @default(false)
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  admins       EventMember[]
  ticketTypes  TicketType[]
  formFields   EventFormField[]
  consentTerms ConsentTerm[]
  orders        Order[]
  registrations Registration[]
  vouchers      Voucher[]
  @@index([tenantId, status])
  @@index([startsAt])
}

model EventMember {
  id      String    @id @default(cuid())
  eventId String
  userId  String
  role    EventRole
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([eventId, userId])
  @@index([userId])
}

model TicketType {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  description String?
  price       Decimal  @db.Decimal(14, 2)
  quota       Int
  salesStart  DateTime?
  salesEnd    DateTime?
  active      Boolean  @default(true)
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  registrations Registration[]
  @@index([eventId])
}

model EventFormField {
  id        String    @id @default(cuid())
  eventId   String
  key       String
  label     String
  type      FieldType
  required  Boolean   @default(false)
  enabled   Boolean   @default(true)
  options   Json?
  sortOrder Int       @default(0)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@unique([eventId, key])
  @@index([eventId, sortOrder])
}

model ConsentTerm {
  id       String  @id @default(cuid())
  eventId  String
  title    String
  body     Text
  required Boolean @default(true)
  version  Int     @default(1)
  event       Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  acceptances ConsentAcceptance[]
}

model PaymentConfig {
  id                 String  @id @default(cuid())
  tenantId           String  @unique
  merchantId         String?
  clientKey          String?
  encryptedServerKey String?
  production         Boolean @default(false)
  updatedAt          DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Order {
  id               String      @id @default(cuid())
  code             String      @unique
  tenantId         String
  eventId          String
  buyerId          String?
  buyerName        String
  buyerEmail       String
  amount           Decimal     @db.Decimal(14, 2)
  discount         Decimal     @default(0) @db.Decimal(14, 2)
  status           OrderStatus @default(PENDING)
  midtransOrderId  String?     @unique
  snapToken        String?
  paidAt           DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  event         Event          @relation(fields: [eventId], references: [id])
  buyer         User?          @relation(fields: [buyerId], references: [id])
  items         OrderItem[]
  registrations Registration[]
  voucherUses   VoucherUse[]
  @@index([tenantId, eventId, status])
  @@index([buyerEmail])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  ticketTypeId String
  quantity     Int
  unitPrice    Decimal @db.Decimal(14, 2)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
}

model Registration {
  id                  String             @id @default(cuid())
  code                String             @unique
  eventId             String
  orderId             String
  ticketTypeId        String
  fullName            String
  email               String
  phone               String?
  formData            Json
  qrToken             String             @unique
  status              RegistrationStatus @default(REGISTERED)
  bibNumber           String?
  verifiedAt          DateTime?
  racePackCollectedAt DateTime?
  checkedInAt         DateTime?
  issueNote           String?
  event            Event               @relation(fields: [eventId], references: [id])
  order            Order               @relation(fields: [orderId], references: [id])
  ticketType       TicketType          @relation(fields: [ticketTypeId], references: [id])
  consents         ConsentAcceptance[]
  verificationLogs VerificationLog[]
  @@index([eventId, status])
  @@index([orderId])
}

model ConsentAcceptance {
  id             String   @id @default(cuid())
  registrationId String
  consentTermId  String
  acceptedAt     DateTime @default(now())
  ipAddress      String?
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  consentTerm  ConsentTerm  @relation(fields: [consentTermId], references: [id])
  @@unique([registrationId, consentTermId])
}

model VerificationLog {
  id             String             @id @default(cuid())
  registrationId String
  staffUserId    String
  fromStatus     RegistrationStatus
  toStatus       RegistrationStatus
  notes          String?
  createdAt      DateTime           @default(now())
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  @@index([registrationId, createdAt])
}

model Voucher {
  id          String   @id @default(cuid())
  tenantId    String
  eventId     String?
  code        String
  percentage  Int?
  fixedAmount Decimal? @db.Decimal(14, 2)
  maxUses     Int?
  usedCount   Int      @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean  @default(true)
  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event  Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uses   VoucherUse[]
  @@unique([tenantId, code])
  @@index([eventId])
}

model VoucherUse {
  id        String   @id @default(cuid())
  voucherId String
  orderId   String
  usedAt    DateTime @default(now())
  voucher Voucher @relation(fields: [voucherId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])
  @@unique([voucherId, orderId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  tenantId  String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id])
  @@index([tenantId, createdAt])
}
