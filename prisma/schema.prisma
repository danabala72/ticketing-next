generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TenantStatus { PENDING ACTIVE SUSPENDED }
enum UserRole { SUPERADMIN TENANT_OWNER EVENT_MANAGER FINANCE CHECKIN_CREW CUSTOMER }
enum EventStatus { DRAFT UPCOMING ONGOING PAST CANCELLED }
enum DiscountType { FIXED PERCENTAGE }
enum OrderStatus { DRAFT RESERVED AWAITING_PAYMENT PAID EXPIRED CANCELLED REFUNDED }
enum PaymentProvider { MIDTRANS MANUAL }
enum PaymentStatus { PENDING SETTLEMENT CAPTURE DENY CANCEL EXPIRE REFUND }
enum FieldType { TEXT EMAIL PHONE NUMBER DATE SELECT CHECKBOX }

model Tenant {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  status            TenantStatus   @default(PENDING)
  midtransServerKey String?
  midtransClientKey String?
  members           TenantMember[]
  events            Event[]
  vouchers          Voucher[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model User {
  id        String          @id @default(cuid())
  name      String
  email     String          @unique
  password  String
  role      UserRole        @default(CUSTOMER)
  tenants   TenantMember[]
  orders    Order[]
  checkIns  CheckInRecord[] @relation("Verifier")
  createdAt DateTime        @default(now())
}

model TenantMember {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      UserRole
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  @@unique([tenantId, userId])
  @@index([tenantId, role])
}

model EventType {
  id        String   @id @default(cuid())
  name      String   @unique
  fields    Json?
  events    Event[]
  createdAt DateTime @default(now())
}

model Event {
  id                 String              @id @default(cuid())
  tenantId           String
  eventTypeId         String
  title              String
  slug               String
  description        String              @db.Text
  status             EventStatus         @default(DRAFT)
  startsAt           DateTime
  endsAt             DateTime
  venueName          String
  city               String
  collectionEnabled  Boolean             @default(false)
  collectionLabel    String?
  midtransServerKey  String?
  midtransClientKey  String?
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  eventType          EventType           @relation(fields: [eventTypeId], references: [id])
  tickets            TicketType[]
  registrationFields RegistrationField[]
  vouchers           Voucher[]
  orders             Order[]
  collectionSessions CollectionSession[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  @@unique([tenantId, slug])
  @@index([tenantId, status, startsAt])
}

model TicketType {
  id           String             @id @default(cuid())
  eventId      String
  name         String
  description  String?
  regularPrice Decimal            @db.Decimal(12, 2)
  specialPrice Decimal?           @db.Decimal(12, 2)
  quota        Int
  saleStartsAt DateTime?
  saleEndsAt   DateTime?
  event        Event              @relation(fields: [eventId], references: [id])
  orderItems   OrderItem[]
  reservations QuotaReservation[]
  @@index([eventId])
}

model RegistrationField {
  id           String    @id @default(cuid())
  eventId      String
  ticketTypeId String?
  label        String
  key          String
  type         FieldType
  required     Boolean   @default(true)
  options      Json?
  sortOrder    Int       @default(0)
  event        Event     @relation(fields: [eventId], references: [id])
  @@unique([eventId, key])
}

model Voucher {
  id             String              @id @default(cuid())
  tenantId       String
  eventId        String?
  code           String
  discountType   DiscountType
  value          Decimal             @db.Decimal(12, 2)
  maxRedemptions Int?
  redeemedCount  Int                 @default(0)
  minQuantity    Int?
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean             @default(true)
  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  event          Event?              @relation(fields: [eventId], references: [id])
  redemptions    VoucherRedemption[]
  @@unique([tenantId, code])
  @@index([eventId])
}

model Order {
  id            String              @id @default(cuid())
  tenantId      String
  eventId       String
  userId        String?
  code          String              @unique
  status        OrderStatus         @default(DRAFT)
  subtotal      Decimal             @db.Decimal(12, 2)
  discountTotal Decimal             @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal             @db.Decimal(12, 2)
  reservedUntil DateTime?
  event         Event               @relation(fields: [eventId], references: [id])
  user          User?               @relation(fields: [userId], references: [id])
  items         OrderItem[]
  reservations  QuotaReservation[]
  payments      PaymentAttempt[]
  voucherUses   VoucherRedemption[]
  registrants   Registrant[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  @@index([tenantId, eventId, status])
}

model OrderItem {
  id           String     @id @default(cuid())
  orderId      String
  ticketTypeId String
  quantity     Int
  unitPrice    Decimal    @db.Decimal(12, 2)
  order        Order      @relation(fields: [orderId], references: [id])
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
}

model QuotaReservation {
  id           String     @id @default(cuid())
  orderId      String
  ticketTypeId String
  quantity     Int
  expiresAt    DateTime
  releasedAt   DateTime?
  order        Order      @relation(fields: [orderId], references: [id])
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id])
  @@index([ticketTypeId, expiresAt, releasedAt])
}

model PaymentAttempt {
  id                    String          @id @default(cuid())
  orderId               String
  provider              PaymentProvider @default(MIDTRANS)
  providerOrderId       String          @unique
  status                PaymentStatus   @default(PENDING)
  amount                Decimal         @db.Decimal(12, 2)
  midtransTransactionId String?
  rawNotification       Json?
  order                 Order           @relation(fields: [orderId], references: [id])
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model VoucherRedemption {
  id        String   @id @default(cuid())
  voucherId String
  orderId   String
  amount    Decimal  @db.Decimal(12, 2)
  voucher   Voucher  @relation(fields: [voucherId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())
  @@unique([voucherId, orderId])
}

model Registrant {
  id             String          @id @default(cuid())
  orderId        String
  ticketTypeId   String
  name           String
  email          String?
  phone          String?
  customAnswers  Json
  qrCode         String          @unique
  order          Order           @relation(fields: [orderId], references: [id])
  checkInRecords CheckInRecord[]
}

model CollectionSession {
  id        String          @id @default(cuid())
  eventId   String
  name      String
  startsAt  DateTime
  endsAt    DateTime
  location  String
  event     Event           @relation(fields: [eventId], references: [id])
  checkIns  CheckInRecord[]
}

model CheckInRecord {
  id                  String            @id @default(cuid())
  collectionSessionId String
  registrantId        String
  verifiedByUserId    String
  status              String
  note                String?
  collectionSession   CollectionSession @relation(fields: [collectionSessionId], references: [id])
  registrant          Registrant        @relation(fields: [registrantId], references: [id])
  verifiedBy          User              @relation("Verifier", fields: [verifiedByUserId], references: [id])
  createdAt           DateTime          @default(now())
  @@unique([collectionSessionId, registrantId])
}
